# port number
PORT=8080

JWT_SECRET=ANYTHING_YOU_WANT

# For Local Docker Container
DB_HOST=host.docker.internal

# NODE_ENV
NODE_ENV=develop

# PostgreSQL URI & User / PW
POSTGRESQL_DATABASE=
POSTGRESQL_USERNAME=
POSTGRESQL_PASSWORD=

RISESET_SERVICE_KEY=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# Sentry (optional, error monitoring is disabled when SENTRY_DSN is empty)
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
