{
  "name": "@snuaaa/api",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "main": "dist/main.js",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc",
    "serve": "node ./dist/main.js",
    "babel-node": "babel-node src/main.js",
    "dev": "nodemon",
    "debug": "nodemon --exec --inspect npm run babel-node",
    "test": "vitest run",
    "clean": "rm -rf ./dist",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" \"test/**/*.ts\" vitest.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\" \"test/**/*.ts\" vitest.config.ts",
    "lint": "eslint \"src/**/*.{ts,js}\" \"test/**/*.ts\" vitest.config.ts",
    "lint:fix": "eslint \"src/**/*.{ts,js}\" \"test/**/*.ts\" vitest.config.ts --fix",
    "db:generate": "drizzle-kit generate --custom",
    "db:migrate": "ts-node src/db/migrate.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "keywords": [],
  "license": "UNLICENSED",
  "author": {
    "name": "Youngjae Kim",
    "email": "yjkim1803@gmail.com"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/client-ses": "^3.1145.0",
    "@sentry/node": "^11.4.0",
    "astronomy-engine": "^2.1.19",
    "bcryptjs": "^2.4.3",
    "body-parser": "^2.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "crypto-random-string": "^3.3.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.3",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "rotating-file-stream": "^1.4.6",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.5",
    "uuid4": "^1.1.4"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/node": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "aws-sdk-client-mock": "^4.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  }
}
